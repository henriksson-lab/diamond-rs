 namespace Cluster {
 
+template<typename It, typename It2>
+int64_t checked_update_clustering(It clustering, It2 mapping, It2 query_begin, It2 query_end, It2 db_begin) {
+	const uint64_t n = query_end - query_begin;
+	int64_t k = 0;
+	for (OId i = 0; i < n; ++i)
+		if (mapping[i] != Mapback::NIL_VALUE && clustering[query_begin[i]] != db_begin[mapping[i]]) {
+			clustering[query_begin[i]] = (typename It::value_type)db_begin[mapping[i]];
+			++k;
+		}
+	return k;
+}
+
 static vector<OId> recluster(shared_ptr<SequenceFile>& db, const vector<OId>& clustering, int iteration) {
 	TaskTimer timer(("*** Initializing recluster iteration " + to_string(iteration + 1)).c_str());
 
